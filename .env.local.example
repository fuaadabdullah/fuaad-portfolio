# Environment variables for local development
# Copy this file to .env.local and fill in your values

# Site URL (will be set automatically by Vercel in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin API token for /api/contact retrieval, /api/ai, and /api/upload
# Generate with: openssl rand -base64 32
ADMIN_TOKEN=your-secure-random-token-here

# Ollama API URL (for AI chat functionality)
# For local development: http://localhost:11434/api/generate
# For Fly.io deployment: https://your-ollama-app.fly.dev/api/generate
OLLAMA_API_URL=http://localhost:11434/api/generate

# Supabase Postgres for contact submissions (Prisma)
# Runtime pooled connection (recommended for deployed apps)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Direct DB connection (required by Prisma migrate/dev tools)
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Optional Supabase client vars (only needed if you add Supabase JS client features)
# NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
