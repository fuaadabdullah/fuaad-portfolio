# Environment variables for local development
# Copy this file to .env.local and fill in your values

# Site URL (will be set automatically by Vercel in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin API token for /api/contact retrieval, /api/ai, and /api/upload
# Generate with: openssl rand -base64 32
ADMIN_TOKEN=your-secure-random-token-here

# TinyLlama on the Oracle Cloud host (see deploy/oracle-ollama/README.md). Server-side only — never prefix
# with NEXT_PUBLIC_. Leave unset for no model; there is no local Ollama.
# The public chat answers only from site data. Uncomment to send unanswered questions to TinyLlama
# (ignored on Vercel production):
# CHAT_TINYLLAMA_EXPERIMENT=true
OLLAMA_BASE_URL=
# Bearer token checked by the Caddy proxy on the Oracle host
# Generate with: openssl rand -hex 32
OLLAMA_API_KEY=
OLLAMA_MODEL=tinyllama:1.1b

# Supabase Postgres for contact submissions (Prisma)
# Runtime pooled connection (recommended for deployed apps)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Direct DB connection (required by Prisma migrate/dev tools)
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Optional Supabase client vars (only needed if you add Supabase JS client features)
# NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
