# Environment variables for local development
# Copy this file to .env.local and fill in your values

# Site URL (will be set automatically by Vercel in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin API token for /api/contact retrieval, /api/ai, and /api/upload
# Generate with: openssl rand -base64 32
ADMIN_TOKEN=your-secure-random-token-here

# Production chat uses this server-side Ollama endpoint for generated responses.
# Set all three values in your hosting environment. Never use NEXT_PUBLIC_ for credentials.
# Without a configured endpoint, production returns 503; local development uses site answers.
# Tests mock fetch or intercept /api/chat; /api/mock-ai is disabled in production.
OLLAMA_BASE_URL=
# Bearer token checked by the Caddy proxy on the Oracle host
# Generate with: openssl rand -hex 32
OLLAMA_API_KEY=
OLLAMA_MODEL=tinyllama:1.1b

# Supabase Postgres for contact submissions (Prisma)
# Runtime pooled connection (recommended for deployed apps)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Direct DB connection (required by Prisma migrate/dev tools)
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Optional Supabase client vars (only needed if you add Supabase JS client features)
# NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
