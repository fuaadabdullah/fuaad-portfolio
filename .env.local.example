# Environment variables for local development
# Copy this file to .env.local and fill in your values

# Site URL (will be set automatically by Vercel in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ollama (chatbox) configuration (server-side only; no NEXT_PUBLIC needed)
#
# Recommended: point this at your GCP Ollama static IP / URL:
# OLLAMA_GCP_URL=http://<your-static-ip>:11434
#
# Local development:
# OLLAMA_BASE_URL=http://localhost:11434
#
# If you already have a full endpoint URL (legacy), this is also accepted:
# OLLAMA_API_URL=http://localhost:11434/api/generate
#
# Optional auth header (Bearer):
# OLLAMA_GCP_API_KEY=your-key
#
# Model to use for the portfolio chatbox (default: gemma:2b)
# PORTFOLIO_OLLAMA_MODEL=gemma:2b
OLLAMA_BASE_URL=http://localhost:11434

# Formspree Form ID (get this from formspree.io after creating a form)
# NEXT_PUBLIC_FORMSPREE_ID=YOUR_FORM_ID
