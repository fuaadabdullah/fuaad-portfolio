# Supabase (recommended) with Prisma
#
# DATABASE_URL: pooled connection (used by app runtime)
# DIRECT_URL: direct connection (used by Prisma migrations/introspection)
#
# Replace [PROJECT-REF] and [PASSWORD] with your actual values from
# Supabase > Project Settings > Database.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Security: Admin token for /api/contact retrieval, /api/ai, and /api/upload
# Generate with: openssl rand -base64 32
# Protect this token like a password — never commit to git
ADMIN_TOKEN=your-secure-random-token-here

# Production chat uses this server-side Ollama endpoint for generated responses.
# Set all three values in your hosting environment. Never use NEXT_PUBLIC_ for credentials.
# Without a configured endpoint, production returns 503; local development uses site answers.
# Tests mock fetch or intercept /api/chat; /api/mock-ai is disabled in production.
OLLAMA_BASE_URL=https://ollama.your-domain.example
OLLAMA_API_KEY=your-ollama-proxy-token
OLLAMA_MODEL=tinyllama:1.1b

# Vercel KV Configuration (for persistent rate limiting)
# These are auto-configured if you connect a KV database in Vercel
# If not available, rate limiting will gracefully degrade
KV_REST_API_URL=https://your-kv-endpoint.kv.vercel.sh
KV_REST_API_TOKEN=your-kv-token
