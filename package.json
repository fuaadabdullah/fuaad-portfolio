{
  "name": "fuaad-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS=--require=./scripts/suppress-baseline-browser-mapping-warning.cjs BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true BROWSERSLIST_IGNORE_OLD_DATA=true next build --webpack",
    "start": "next start",
    "lint": "eslint --max-warnings 0 app components lib data",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "generate-resume": "node scripts/generate-resume-pdf.cjs",
    "capture-screenshots": "TMPDIR=/tmp node scripts/capture-rizzk-screenshot.js",
    "process-headshot": "node scripts/process-headshot.js",
    "process-headshot:roomy": "node scripts/process-headshot.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.0.1",
    "@types/mdx": "^2.0.13",
    "@vercel/analytics": "^1.5.0",
    "clsx": "2.1.1",
    "framer-motion": "12.34.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "0.563.0",
    "markdown-it": "^14.1.0",
    "next": "^16.0.10",
    "node-fetch": "^3.3.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.68.0",
    "rehype-highlight": "^7.0.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@storybook/nextjs-vite": "10.2.0-alpha.6",
    "@tailwindcss/postcss": "^4.1.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "20.19.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "10.4.24",
    "baseline-browser-mapping": "2.9.19",
    "critters": "^0.0.25",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.10",
    "eslint-plugin-storybook": "10.2.0-alpha.6",
    "jsdom": "^27.3.0",
    "md-to-pdf": "^5.2.4",
    "postcss": "8.5.6",
    "puppeteer": "^24.28.0",
    "storybook": "10.2.0-alpha.6",
    "tailwindcss": "4.1.18",
    "typescript": "5.8.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15",
    "prettier": "^3.7.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "next-mdx-remote": "6.0.0"
  },
  "pnpm": {
    "overrides": {
      "next-mdx-remote": "6.0.0"
    }
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "eslint --ext .ts,.tsx --fix",
      "prettier --write"
    ],
    "**/*.{json,md,css,html}": [
      "prettier --write"
    ]
  }
}
